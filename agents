import os
from crewai import Agent, Crew, Process, Task
from langchain_openai import ChatOpenAI

# 1. FILLING THE BLANK: Pointing to the correct OpenRouter v1 endpoint URL
llm = ChatOpenAI(
    base_url="https://openrouter.ai",
    api_key=os.getenv("OPEN_ROUTER_FREE_KEY"),
    model="meta-llama/llama-3.3-70b-instruct:free" 
)

# Agent 1: The Product / Inventory Manager
inventory_agent = Agent(
    role='E-commerce Product Manager',
    goal='Research trending digital items or niches and curate a product catalog list.',
    backstory='An algorithmic trend-spotter that knows what sells online and structures items with compelling descriptions.',
    verbose=True, llm=llm
)

# Agent 2: The Frontend Web Developer
developer_agent = Agent(
    role='Storefront Web Engineer',
    goal='Convert the product catalog into a beautiful, fully functional single-page modern HTML/CSS storefront.',
    backstory='An expert UI developer that writes production-ready, clean web markup with responsive product grids.',
    verbose=True, llm=llm
)

# 2. FILLING THE BLANK: Creating the Amboras-Style Hustler Agent
amboras_hustle_agent = Agent(
    role='Hyper-Active Sales Conversion Optimizer',
    goal='Relentlessly audit the live store interface to slash friction, clear stock, and push urgent customer conversions.',
    backstory='An aggressive digital growth marketer inspired by Amboras. This agent monitors simulated visitor friction logs and dynamically injects conversion elements like flash discounts, bundle metrics, low-stock warnings, and countdown banners directly into the web code.',
    verbose=True, llm=llm
)

# Define tasks for your automated store loop
task1 = Task(
    description='Analyze market gaps and generate a catalog of 3 new digital products or clothing items with pricing.',
    expected_output='A clean markdown list of products, descriptions, prices, and mock checkout link parameters.',
    agent=inventory_agent
)

task2 = Task(
    description='Take the product list and overwrite the file located at "website/index.html". Ensure it has a clean header, modern grid layout, and looks professional.',
    expected_output='A fully completed, standalone HTML string saved to the website directory.',
    agent=developer_agent,
    output_file='website/index.html'
)

# 3. FILLING THE BLANK: The Optimization Hustle Task
# It pulls the latest generated website code, simulates customer pushback, and applies aggressive sales patches
task3 = Task(
    description=(
        'Read the file located at "website/index.html". Act as an Amboras automation layer. '
        'Modify the file by injecting high-urgency conversion tactics. Add elements like: '
        '"Only 3 items remaining!", a limited-time flash discount code banner (e.g., HUSTLE20), '
        'and prominent, high-contrast checkout buttons to actively push the items out the door. '
        'Overwrite the existing "website/index.html" file with this high-converting design.'
    ),
    expected_output='An optimized HTML file with added high-conversion sales copy, discount codes, and scarcity banners.',
    agent=amboras_hustle_agent,
    output_file='website/index.html'
)

# 4. FILLING THE BLANK: Finalizing the Unified Company pipeline
store_company = Crew(
    agents=[inventory_agent, developer_agent, amboras_hustle_agent],
    tasks=[task1, task2, task3],
    process=Process.sequential
)

if __name__ == "__main__":
    store_company.kickoff()

